%% ============================================================
%% Loans & Real Estate Platform — MASTER ER DIAGRAM v1.4
%% Web-only · FastAPI + Next.js · PostgreSQL + Redis
%% FINAL DATABASE SEGREGATION MODEL
%% ------------------------------------------------------------
%% v1.4 decisions baked in:
%%  1. No database row uses business_line = both.
%%  2. auth_users stores login/mobile/password identity only.
%%  3. client_profiles stores one row per client per line.
%%     A customer using Loans + Real Estate has two rows under one auth_user.
%%  4. agent_profiles stores one row per approved agent per line.
%%  5. staff_profiles stores Admin/Sub Admin/Telecaller/Employee capability.
%%     Telecaller/Employee are line-scoped; Admin/Sub Admin are platform-scoped.
%%  6. Business records carry one immutable business_line: loans or real_estate.
%%  7. Agent leads do not auto-expire; Admin can manually release attribution.
%%  8. Employee tasks are Admin-created for MVP.
%% ============================================================

erDiagram

    %% ---------- AUTH / IDENTITY ----------
    auth_users {
        uuid id PK
        text first_name
        text last_name
        text mobile UK "E.164; one login identity"
        text email "optional"
        text password_hash
        status_enum status "active/suspended/pending_reset/soft_deleted"
        timestamptz phone_verified_at
        timestamptz last_login_at
        uuid created_by_auth_user_uuid FK
        timestamptz created_at
        timestamptz updated_at
    }

    refresh_tokens {
        uuid id PK
        uuid auth_user_uuid FK
        text token_hash
        timestamptz issued_at
        timestamptz expires_at
        boolean revoked
        uuid replaced_by
        text user_agent
        text ip
    }

    auth_events {
        uuid id PK
        uuid auth_user_uuid FK "null if unresolved"
        text event_type
        text mobile
        text ip
        text user_agent
        boolean success
        jsonb detail
        timestamptz created_at
    }

    %% ---------- PROFILE ROWS ----------
    client_profiles {
        uuid id PK
        uuid auth_user_uuid FK
        business_line_enum business_line "loans | real_estate only"
        text customer_code UK "line-specific customer ID"
        profile_status status
        timestamptz created_at
        timestamptz updated_at
    }

    staff_profiles {
        uuid id PK
        uuid auth_user_uuid FK
        staff_role role "admin/sub_admin/telecaller/employee"
        profile_scope scope "platform | line"
        business_line_enum business_line "null for platform; loans/real_estate for line scope"
        text staff_code UK
        profile_status status
        uuid created_by_auth_user_uuid FK
        timestamptz created_at
        timestamptz updated_at
    }

    agent_applications {
        uuid id PK
        uuid applicant_auth_user_uuid FK "existing login if matched"
        text first_name
        text last_name
        text mobile
        business_line_enum business_line "loans | real_estate only"
        text aadhaar_ref
        text pan_ref
        text photo_ref
        text address_proof_ref
        text rera_code "required for real_estate"
        submission_status status "pending/approved/rejected"
        uuid reviewed_by_staff_profile_uuid FK "Admin"
        timestamptz reviewed_at
        timestamptz created_at
    }

    agent_profiles {
        uuid id PK
        uuid auth_user_uuid FK
        text agent_code UK "line-specific AG code"
        business_line_enum business_line "loans | real_estate only"
        uuid application_uuid FK
        boolean converted_from_client
        text kyc_status
        text rera_code "required for real_estate"
        profile_status status
        uuid approved_by_staff_profile_uuid FK "Admin"
        timestamptz approved_at
        timestamptz created_at
        timestamptz updated_at
    }

    %% ---------- LEAD SPINE ----------
    leads {
        uuid id PK
        uuid client_profile_uuid FK "null until claimed/registered"
        business_line_enum business_line "loans | real_estate only"
        lead_origin origin "direct/agent"
        uuid origin_agent_profile_uuid FK "agent attribution"
        uuid assigned_telecaller_profile_uuid FK
        text name
        text mobile "dedupe within business_line"
        jsonb requirement
        lead_status status "new/assigned/working/converted/closed/released"
        timestamptz released_at "Admin exception only"
        text release_reason
        timestamptz created_at
        timestamptz updated_at
    }

    lead_activities {
        uuid id PK
        uuid lead_uuid FK
        uuid telecaller_profile_uuid FK
        business_line_enum business_line
        call_disposition disposition
        interest_level interest_level
        text notes
        timestamptz follow_up_at
        timestamptz created_at
    }

    %% ---------- LOANS LINE ----------
    loan_applications {
        uuid id PK
        uuid lead_uuid FK
        uuid client_profile_uuid FK
        business_line_enum business_line "const loans"
        uuid loan_type_id FK
        uuid bank_id FK
        numeric amount_requested
        numeric amount_sanctioned
        numeric interest_rate
        numeric processing_fee
        fee_outcome fee_outcome
        loan_status status
        text status_reason
        timestamptz opened_at
        timestamptz closed_at
    }

    loan_txn_history {
        uuid id PK
        uuid loan_application_uuid FK
        text bank_name
        numeric amount
        numeric interest_rate
        date txn_date
        uuid entered_by_profile_uuid FK "loans telecaller"
        timestamptz created_at
    }

    banks {
        uuid id PK
        text name
        text logo_key
        boolean active
        timestamptz created_at
    }

    loan_types {
        uuid id PK
        text name UK
        text label
        boolean active
        jsonb custom_fields "null = shared field set"
        timestamptz created_at
    }

    bank_loan_type_availability {
        uuid bank_id PK,FK
        uuid loan_type_id PK,FK
        boolean available
    }

    %% ---------- REAL ESTATE LINE ----------
    properties {
        uuid id PK
        text title
        text rera_number
        jsonb details
        boolean active
        timestamptz created_at
    }

    property_inquiries {
        uuid id PK
        uuid lead_uuid FK
        uuid client_profile_uuid FK
        business_line_enum business_line "const real_estate"
        uuid property_uuid FK
        property_inquiry_status status
        text notes
        timestamptz created_at
        timestamptz updated_at
    }

    property_visits {
        uuid id PK
        uuid inquiry_uuid FK
        timestamptz scheduled_at
        timestamptz visited_at
        visit_status status
        timestamptz created_at
    }

    vehicle_arrangements {
        uuid id PK
        uuid visit_uuid FK "UNIQUE; 1:1"
        text pickup_location
        timestamptz pickup_time
        vehicle_status status
        text vehicle_info
        text driver_name
        text driver_mobile
        uuid arranged_by_profile_uuid FK "staff profile"
        timestamptz created_at
        timestamptz updated_at
    }

    property_submissions {
        uuid id PK
        uuid uploaded_by_agent_profile_uuid FK
        uuid uploaded_by_staff_profile_uuid FK
        business_line_enum business_line "const real_estate"
        uuid property_uuid FK
        text title
        jsonb details
        text rera_number
        submission_status status
        text rejection_reason
        uuid reviewed_by_profile_uuid FK "Admin"
        timestamptz reviewed_at
        timestamptz created_at
        timestamptz updated_at
    }

    %% ---------- MONEY ----------
    transactions {
        uuid id PK
        uuid client_profile_uuid FK "nullable after de-link"
        uuid agent_profile_uuid FK "for commission payout recipient when needed"
        text retained_ref
        business_line_enum business_line
        txn_type type "cashback/referral_payout/commission_payout"
        numeric amount
        txn_method method "razorpay/cheque"
        txn_status status
        text payment_ref
        timestamptz paid_at
        uuid loan_application_uuid FK "cashback source"
        timestamptz created_at
    }

    commissions {
        uuid id PK
        uuid agent_profile_uuid FK
        business_line_enum business_line
        uuid lead_uuid FK
        uuid loan_application_uuid FK
        uuid property_inquiry_uuid FK
        numeric agreed_amount
        commission_status status
        txn_method method
        uuid payout_txn_uuid FK
        uuid entered_by_profile_uuid FK "Admin"
        text notes
        timestamptz created_at
        timestamptz updated_at
    }

    %% ---------- REFERRALS ----------
    referral_codes {
        uuid auth_user_uuid PK
        text code UK
        timestamptz created_at
    }

    referrals {
        uuid id PK
        uuid referrer_auth_user_uuid FK
        text referred_mobile
        business_line_enum business_line
        uuid referred_lead_uuid FK
        text conversion_status
        uuid reward_txn_uuid FK
        timestamptz created_at
    }

    referral_bonus_config {
        uuid id PK
        business_line_enum business_line
        numeric bonus_amount
        jsonb rule
        boolean active
        uuid created_by_profile_uuid FK "Sub Admin"
        timestamptz updated_at
    }

    %% ---------- CONTENT / MARKETING ----------
    banners {
        uuid id PK
        business_line_enum business_line
        banner_type banner_type
        text title
        text image_key
        text deep_link
        jsonb audience_rules
        int priority
        banner_status status
        uuid created_by_profile_uuid FK
        uuid approved_by_profile_uuid FK
        timestamptz starts_at
        timestamptz ends_at
        timestamptz created_at
        timestamptz updated_at
    }

    offers {
        uuid id PK
        business_line_enum business_line
        text title
        text description
        text discount_type
        numeric discount_value
        text code
        offer_status status
        uuid created_by_profile_uuid FK
        timestamptz starts_at
        timestamptz ends_at
        timestamptz created_at
    }

    content_blocks {
        uuid id PK
        text slug UK
        text section
        text title
        text body
        business_line_enum business_line "nullable/global allowed"
        content_status status
        uuid created_by_profile_uuid FK
        timestamptz updated_at
    }

    %% ---------- ADMIN CONFIG / AUDIT ----------
    field_visibility_config {
        uuid id PK
        field_target_role target_role
        text entity
        text field_key
        boolean visible
        uuid updated_by_profile_uuid FK
        timestamptz updated_at
    }

    media_assets {
        uuid id PK
        business_line_enum business_line
        gallery gallery
        media_type media_type
        text object_key
        text title
        uuid uploaded_by_profile_uuid FK
        timestamptz created_at
    }

    audit_log {
        uuid id PK
        uuid actor_auth_user_uuid FK
        audit_action action
        text entity_type
        uuid entity_uuid
        business_line_enum business_line
        jsonb detail
        timestamptz created_at
    }

    %% ---------- FIELD WORK ----------
    tasks {
        uuid id PK
        uuid assigned_employee_profile_uuid FK
        uuid assigned_by_profile_uuid FK "Admin-only for MVP"
        business_line_enum business_line
        task_type task_type
        uuid lead_uuid FK
        uuid loan_application_uuid FK
        uuid property_inquiry_uuid FK
        uuid property_visit_uuid FK
        task_status status
        bg_check_outcome outcome
        text notes
        timestamptz due_at
        timestamptz completed_at
        timestamptz created_at
        timestamptz updated_at
    }

    task_documents {
        uuid id PK
        uuid task_uuid FK
        text doc_type
        text object_key
        boolean verified "Admin completeness check"
        uuid verified_by_profile_uuid FK "Admin"
        timestamptz verified_at
        timestamptz uploaded_at
        timestamptz created_at
    }

    %% ---------- NOTIFICATIONS & SUPPORT ----------
    notifications {
        uuid id PK
        uuid auth_user_uuid FK "recipient identity"
        uuid client_profile_uuid FK "optional line-specific context"
        business_line_enum business_line
        text type
        text title
        text body
        text deep_link
        timestamptz read_at
        timestamptz created_at
    }

    support_tickets {
        uuid id PK
        uuid auth_user_uuid FK "identity-level issue"
        uuid client_profile_uuid FK "optional line-specific issue"
        support_category category
        text subject
        text body
        support_status status
        uuid handled_by_profile_uuid FK "Admin"
        timestamptz created_at
        timestamptz updated_at
    }

    %% ---------- RELATIONSHIPS ----------
    auth_users ||--o{ refresh_tokens : has
    auth_users ||--o{ auth_events : logs
    auth_users ||--o{ client_profiles : owns
    auth_users ||--o{ staff_profiles : has
    auth_users ||--o{ agent_applications : applies
    auth_users ||--o{ agent_profiles : has
    agent_applications ||--o| agent_profiles : approved_into

    client_profiles ||--o{ leads : owns
    agent_profiles ||--o{ leads : introduces
    staff_profiles ||--o{ leads : assigned_telecaller
    leads ||--o{ lead_activities : has
    staff_profiles ||--o{ lead_activities : logs

    leads ||--o{ loan_applications : spawns
    client_profiles ||--o{ loan_applications : owns
    loan_types ||--o{ loan_applications : typed
    banks ||--o{ loan_applications : via
    loan_applications ||--o{ loan_txn_history : history
    staff_profiles ||--o{ loan_txn_history : enters

    leads ||--o{ property_inquiries : spawns
    client_profiles ||--o{ property_inquiries : owns
    properties ||--o{ property_inquiries : subject
    property_inquiries ||--o{ property_visits : schedules
    property_visits ||--|| vehicle_arrangements : pickup
    staff_profiles ||--o{ vehicle_arrangements : arranges
    agent_profiles ||--o{ property_submissions : uploads
    staff_profiles ||--o{ property_submissions : uploads_reviews
    properties ||--o| property_submissions : published_from

    client_profiles ||--o{ transactions : receives
    agent_profiles ||--o{ transactions : commission_recipient
    loan_applications ||--o| transactions : cashback
    referrals ||--o| transactions : reward
    commissions ||--o| transactions : payout

    agent_profiles ||--o{ commissions : earns
    leads ||--o{ commissions : source
    loan_applications ||--o| commissions : loan_deal
    property_inquiries ||--o| commissions : re_deal
    staff_profiles ||--o{ commissions : entered_by

    auth_users ||--|| referral_codes : has
    auth_users ||--o{ referrals : refers
    leads ||--o| referrals : converts
    staff_profiles ||--o{ referral_bonus_config : configures

    staff_profiles ||--o{ banners : creates_approves
    staff_profiles ||--o{ offers : creates
    staff_profiles ||--o{ content_blocks : authors

    banks ||--o{ bank_loan_type_availability : offers
    loan_types ||--o{ bank_loan_type_availability : available_at
    staff_profiles ||--o{ field_visibility_config : sets
    staff_profiles ||--o{ media_assets : uploads
    auth_users ||--o{ audit_log : acts

    staff_profiles ||--o{ tasks : assigned_employee
    staff_profiles ||--o{ tasks : assigned_by_admin
    leads ||--o{ tasks : context
    loan_applications ||--o{ tasks : context
    property_inquiries ||--o{ tasks : context
    property_visits ||--o| tasks : visit_task
    tasks ||--o{ task_documents : collects
    staff_profiles ||--o{ task_documents : verifies

    auth_users ||--o{ notifications : receives
    client_profiles ||--o{ notifications : line_context
    auth_users ||--o{ support_tickets : raises
    client_profiles ||--o{ support_tickets : line_context
    staff_profiles ||--o{ support_tickets : handles
