%% ============================================================
%% Loans & Real Estate Platform — MASTER ER DIAGRAM
%% Consolidated from 9 design docs · Web-only · FastAPI + Next.js
%% PostgreSQL + RLS (single-DB + business_line discriminator)
%% Supersedes the per-doc Eraser diagrams.
%% ------------------------------------------------------------
%% DECISIONS BAKED IN (this round):
%%  1. business_line_enum = {loans, real_estate, both}; NOT NULL on
%%     users with a role CHECK. 'both' allowed for admin, sub_admin,
%%     AND client (a client may hold loan + property journeys under
%%     ONE account; per-record business_line still single + immutable).
%%     Single line REQUIRED for agent/telecaller/employee — staff and
%%     agents stay line-scoped (team-level segregation is the real wall).
%%  2. property_visits.employee_uuid DROPPED — tasks is the single
%%     source of truth for assignment (join via property_visit_uuid).
%%  3. transactions: razorpay_payment_id -> payment_ref (generic),
%%     + paid_at added. txn_type includes commission_payout.
%%  4. vehicle_arrangements UNCHANGED — stays on arranged_by_uuid,
%%     not folded into tasks.
%%  5. tasks.assigned_by_uuid restricted to Admin (app-level + note).
%%  6. CLIENT -> AGENT transition (agents are single-line):
%%     - single-line client applying as agent in the SAME line
%%       => in-place upgrade: role flips client->agent, business_line
%%          unchanged, new AG user_id issued, old code kept in
%%          previous_user_id, UUID unchanged (history preserved).
%%     - 'both' client (or single-line client applying in the OTHER
%%       line) => SEPARATE agent account on a DIFFERENT mobile; the
%%       existing client account is left intact with its journeys.
%%       Agents are NEVER 'both'. No user_roles table — mobile UNIQUE
%%       + immutable business_line enforce it (generalizes old rule:
%%       one person = loan client + RE agent via two mobiles).
%%  7. AGENT-INTRODUCED LEAD -> CLIENT LOGIN ("claim" flow):
%%     lead is created with user_uuid NULL. Agent shares an invite LINK
%%     (stateless signed token: lead + origin_agent + expiry; NO DB row).
%%     Lead opens it -> pre-filled register -> OTP to THEIR phone ->
%%     set password -> users row created (business_line ADOPTED from the
%%     lead, no line-picker) -> leads.user_uuid bound by the OTP-VERIFIED
%%     mobile. Link = onboarding + attribution only; OTP is the gate (a
%%     leaked/forwarded link cannot claim — OTP goes to the number).
%%     Registering normally with the same number binds the lead the same
%%     way (link is an accelerant, not load-bearing). No schema change.
%%  8. NOTIFICATIONS + SUPPORT_TICKETS added (were specified in Client
%%     §5.9 but missing from earlier ERD revisions). notifications =
%%     per-user web-push feed (deep_link redirect, FR-11.2). support_
%%     tickets = client/employee/agent issues; login/OTP/lost-mobile
%%     routed exclusively to Admin (handled_by_uuid, FR-14.2).
%%  9. PAYOUT-LINK CONVENTION (one direction per pair, no two-way FK):
%%     the link to a payout transaction lives on the SOURCE record's
%%     *_txn_uuid where an intermediate record exists —
%%     referrals.reward_txn_uuid, commissions.payout_txn_uuid. Cashback
%%     has NO intermediate record, so its single link sits on
%%     transactions.loan_application_uuid. transactions.referral_uuid
%%     DROPPED (was redundant with referrals.reward_txn_uuid). Every
%%     source->payout edge is 1:0..1 (cashback/reward/payout all o|).
%% ============================================================

erDiagram

    %% ---------- AUTH ----------
    users {
        uuid id PK
        text user_id UK "CL7K9FJOHN — display only"
        text previous_user_id "kept on role upgrade"
        text first_name
        text last_name
        text mobile UK "E.164 — one-number-one-profile"
        text email "optional"
        text password_hash "null only in register window"
        role_enum role
        business_line_enum business_line "NOT NULL; both=admin/subadmin/client"
        status_enum status
        timestamptz phone_verified_at "null => provisioned"
        timestamptz last_login_at
        uuid created_by FK
        timestamptz created_at
        timestamptz updated_at
    }
    refresh_tokens {
        uuid id PK
        uuid user_uuid FK
        text token_hash
        timestamptz issued_at
        timestamptz expires_at
        boolean revoked
        uuid replaced_by "rotation lineage"
        text user_agent
        text ip
    }
    auth_events {
        uuid id PK
        uuid user_uuid FK "null if unresolved"
        text event_type
        text mobile
        text ip
        text user_agent
        boolean success
        jsonb detail
        timestamptz created_at
    }
    agent_applications {
        uuid id PK
        text first_name
        text last_name
        text mobile
        business_line_enum business_line "single line — never both"
        text aadhaar_ref
        text pan_ref
        text photo_ref
        text address_proof_ref
        text rera_code "required for real_estate"
        submission_status status "pending/approved/rejected"
        uuid reviewed_by FK
        timestamptz reviewed_at
        timestamptz created_at
    }

    %% ---------- LEAD SPINE ----------
    leads {
        uuid id PK
        uuid user_uuid FK "null until claim; bound by OTP-verified mobile"
        business_line_enum business_line
        lead_origin origin "direct/agent"
        uuid origin_agent_uuid FK "never transferred (FR-4.6)"
        uuid assigned_telecaller_uuid FK
        text name
        text mobile "dedupe key (FR-4.5)"
        jsonb requirement
        lead_status status
        timestamptz expiry_at "open-pool timer"
        timestamptz created_at
        timestamptz updated_at
    }
    lead_activities {
        uuid id PK
        uuid lead_uuid FK
        uuid telecaller_uuid FK
        business_line_enum business_line
        call_disposition disposition
        interest_level interest_level "set when connected"
        text notes
        timestamptz follow_up_at "drives follow-ups-due"
        timestamptz created_at
    }

    %% ---------- LOANS LINE ----------
    loan_applications {
        uuid id PK
        uuid lead_uuid FK
        uuid user_uuid FK "denormalized for RLS"
        business_line_enum business_line "const loans"
        uuid loan_type_id FK
        uuid bank_id FK
        numeric amount_requested
        numeric amount_sanctioned
        numeric interest_rate
        numeric processing_fee
        fee_outcome fee_outcome "waived/cashback/none"
        loan_status status
        text status_reason "shown on hold/rejected"
        timestamptz opened_at
        timestamptz closed_at
    }
    loan_txn_history {
        uuid id PK
        uuid loan_application_uuid FK
        text bank_name
        numeric amount
        numeric interest_rate
        date txn_date
        uuid entered_by_uuid FK "telecaller"
        timestamptz created_at
    }

    %% ---------- REAL ESTATE LINE ----------
    property_inquiries {
        uuid id PK
        uuid lead_uuid FK
        uuid user_uuid FK
        business_line_enum business_line "const real_estate"
        uuid property_uuid FK "external (RE module)"
        property_inquiry_status status
        text notes
        timestamptz created_at
        timestamptz updated_at
    }
    property_visits {
        uuid id PK
        uuid inquiry_uuid FK
        timestamptz scheduled_at
        timestamptz visited_at
        visit_status status "scheduled/completed/cancelled/no_show"
        timestamptz created_at
    }
    vehicle_arrangements {
        uuid id PK
        uuid visit_uuid FK "UNIQUE — 1:1 with visit"
        text pickup_location "client-set"
        timestamptz pickup_time "client-set"
        vehicle_status status "company-managed"
        text vehicle_info "company-set"
        text driver_name "company-set"
        text driver_mobile "company driver — no masking"
        uuid arranged_by_uuid FK "Employee/Admin"
        timestamptz created_at
        timestamptz updated_at
    }
    property_submissions {
        uuid id PK
        uuid uploaded_by_uuid FK "agent/subadmin/client"
        business_line_enum business_line "const real_estate"
        uuid property_uuid FK "set on approval"
        text title
        jsonb details
        text rera_number "verified at approval"
        submission_status status "pending/approved/rejected"
        text rejection_reason
        uuid reviewed_by_uuid FK "Admin"
        timestamptz reviewed_at
        timestamptz created_at
        timestamptz updated_at
    }

    %% ---------- MONEY ----------
    transactions {
        uuid id PK
        uuid user_uuid FK "SET NULL on de-link"
        text retained_ref "internal ref after PII purge"
        business_line_enum business_line
        txn_type type "cashback/referral_payout/commission_payout"
        numeric amount
        txn_method method "razorpay/cheque"
        txn_status status "initiated/processing/paid/failed"
        text payment_ref "razorpay id OR cheque no"
        timestamptz paid_at "real-world settlement date"
        uuid loan_application_uuid FK "cashback source (no intermediate table)"
        timestamptz created_at
    }
    commissions {
        uuid id PK
        uuid agent_user_uuid FK
        business_line_enum business_line
        uuid lead_uuid FK
        uuid loan_application_uuid FK "loans source"
        uuid property_inquiry_uuid FK "RE source"
        numeric agreed_amount "manual, Admin-entered"
        commission_status status "pending/approved/paid/cancelled"
        txn_method method "set at payout"
        uuid payout_txn_uuid FK "links to transactions"
        uuid entered_by_uuid FK "Admin (logged)"
        text notes
        timestamptz created_at
        timestamptz updated_at
    }

    %% ---------- REFERRALS ----------
    referral_codes {
        uuid user_uuid PK "one per client"
        text code UK
        timestamptz created_at
    }
    referrals {
        uuid id PK
        uuid referrer_user_uuid FK
        text referred_mobile
        uuid referred_lead_uuid FK
        text conversion_status "pending/converted/not_converted"
        uuid reward_txn_uuid FK "set on conversion"
        timestamptz created_at
    }
    referral_bonus_config {
        uuid id PK
        business_line_enum business_line
        numeric bonus_amount
        jsonb rule "conditions/caps"
        boolean active
        uuid created_by_uuid FK "Sub Admin"
        timestamptz updated_at
    }

    %% ---------- CONTENT / MARKETING ----------
    banners {
        uuid id PK
        business_line_enum business_line
        banner_type banner_type "default/personalized/action"
        text title
        text image_key
        text deep_link
        jsonb audience_rules
        int priority "tie-break"
        banner_status status
        uuid created_by_uuid FK "Sub Admin"
        uuid approved_by_uuid FK "Admin"
        timestamptz starts_at
        timestamptz ends_at
        timestamptz created_at
        timestamptz updated_at
    }
    offers {
        uuid id PK
        business_line_enum business_line
        text title
        text description
        text discount_type
        numeric discount_value
        text code "optional promo"
        offer_status status
        uuid created_by_uuid FK
        timestamptz starts_at
        timestamptz ends_at
        timestamptz created_at
    }
    content_blocks {
        uuid id PK
        text slug UK
        text section
        text title
        text body
        business_line_enum business_line "null = global"
        content_status status
        uuid created_by_uuid FK
        timestamptz updated_at
    }

    %% ---------- ADMIN CONFIG ----------
    banks {
        uuid id PK
        text name
        text logo_key
        boolean active
        timestamptz created_at
    }
    loan_types {
        uuid id PK
        text name UK
        text label
        boolean active
        jsonb custom_fields "null = shared field set (v1)"
        timestamptz created_at
    }
    bank_loan_type_availability {
        uuid bank_id PK,FK
        uuid loan_type_id PK,FK
        boolean available
    }
    field_visibility_config {
        uuid id PK
        field_target_role target_role "agent/telecaller/employee"
        text entity
        text field_key
        boolean visible
        uuid updated_by_uuid FK
        timestamptz updated_at
    }
    media_assets {
        uuid id PK
        business_line_enum business_line
        gallery gallery "loans/real_estate — separate"
        media_type media_type "image/video/pdf"
        text object_key
        text title
        uuid uploaded_by_uuid FK
        timestamptz created_at
    }
    audit_log {
        uuid id PK
        uuid actor_uuid FK
        audit_action action
        text entity_type
        uuid entity_uuid
        business_line_enum business_line
        jsonb detail "before/after, reason"
        timestamptz created_at
    }

    %% ---------- FIELD WORK / TASK SPINE ----------
    tasks {
        uuid id PK
        uuid assigned_employee_uuid FK
        uuid assigned_by_uuid FK "Admin-only (FR-2.6)"
        business_line_enum business_line
        task_type task_type "visit/doc_collection/bg_check"
        uuid lead_uuid FK
        uuid loan_application_uuid FK
        uuid property_inquiry_uuid FK
        uuid property_visit_uuid FK "1:1 for visit tasks"
        task_status status
        bg_check_outcome outcome "bg_check only"
        text notes
        timestamptz due_at
        timestamptz completed_at
        timestamptz created_at
        timestamptz updated_at
    }
    task_documents {
        uuid id PK
        uuid task_uuid FK
        text doc_type
        text object_key
        boolean verified "set downstream, not employee"
        timestamptz uploaded_at
        timestamptz created_at
    }

    %% ---------- NOTIFICATIONS & SUPPORT ----------
    notifications {
        uuid id PK
        uuid user_uuid FK "recipient"
        business_line_enum business_line
        text type "process/status/event"
        text title
        text body
        text deep_link "redirect target (FR-11.2)"
        timestamptz read_at "null = unread"
        timestamptz created_at
    }
    support_tickets {
        uuid id PK
        uuid user_uuid FK "null for pre-login issues"
        support_category category "forgot_password/otp_issue/lost_mobile/general"
        text subject
        text body
        support_status status "open/in_progress/resolved"
        uuid handled_by_uuid FK "Admin only (FR-14.2)"
        timestamptz created_at
        timestamptz updated_at
    }

    %% ---------- EXTERNAL (owned by RE module) ----------
    properties {
        uuid id PK
        text note "stub — owned by RE module"
    }

    %% ============================================================
    %% RELATIONSHIPS
    %% ============================================================
    users ||--o{ refresh_tokens : "has"
    users ||--o{ auth_events : "logs"
    users ||--o{ agent_applications : "reviews"

    users ||--o{ leads : "owns (borrower/buyer)"
    users ||--o{ leads : "introduced (agent)"
    users ||--o{ leads : "assigned (telecaller)"
    leads ||--o{ lead_activities : "has"
    users ||--o{ lead_activities : "logs (telecaller)"

    leads ||--o{ loan_applications : "spawns"
    users ||--o{ loan_applications : "owns"
    loan_types ||--o{ loan_applications : "typed"
    banks ||--o{ loan_applications : "via"
    loan_applications ||--o{ loan_txn_history : "history"
    users ||--o{ loan_txn_history : "enters"

    leads ||--o{ property_inquiries : "spawns"
    users ||--o{ property_inquiries : "owns"
    properties ||--o{ property_inquiries : "subject"
    property_inquiries ||--o{ property_visits : "schedules"
    property_visits ||--|| vehicle_arrangements : "1:1 pickup"
    users ||--o{ vehicle_arrangements : "arranges"

    users ||--o{ property_submissions : "uploads"
    properties ||--o| property_submissions : "published from"

    users ||--o{ transactions : "paid to"
    loan_applications ||--o| transactions : "cashback"
    referrals ||--o| transactions : "reward"

    users ||--o{ commissions : "earns (agent)"
    leads ||--o{ commissions : "converted"
    loan_applications ||--o| commissions : "loans deal"
    property_inquiries ||--o| commissions : "RE deal"
    commissions ||--o| transactions : "payout"

    users ||--|| referral_codes : "has one"
    users ||--o{ referrals : "refers"
    leads ||--o| referrals : "converts"

    users ||--o{ referral_bonus_config : "configures"
    users ||--o{ banners : "creates/approves"
    users ||--o{ offers : "creates"
    users ||--o{ content_blocks : "authors"

    banks ||--o{ bank_loan_type_availability : "offers"
    loan_types ||--o{ bank_loan_type_availability : "available at"
    users ||--o{ field_visibility_config : "sets"
    users ||--o{ media_assets : "uploads"
    users ||--o{ audit_log : "acts"

    users ||--o{ tasks : "assigned to (employee)"
    users ||--o{ tasks : "assigned by (admin)"
    leads ||--o{ tasks : "context"
    loan_applications ||--o{ tasks : "context"
    property_inquiries ||--o{ tasks : "context"
    property_visits ||--o| tasks : "1:1 visit task"
    tasks ||--o{ task_documents : "collects"

    users ||--o{ notifications : "receives"
    users ||--o{ support_tickets : "raises"
    users ||--o{ support_tickets : "handles (admin)"
