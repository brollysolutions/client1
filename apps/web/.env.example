# Copy to .env.local (gitignored). Public vars are exposed to the browser — no secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Use | to render multiple lines.
NEXT_PUBLIC_CONTACT_HOURS=Monday to Saturday|10:00 AM to 7:00 PM
NEXT_PUBLIC_CONTACT_ADDRESS=1st Floor, Sample Towers|Banjara Hills, Hyderabad 500034
