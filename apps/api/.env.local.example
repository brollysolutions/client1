# Local dev overrides for apps/api. Copy to .env.local (gitignored); every
# value below is optional; all defaults in app/core/config.py are safe for
# ENV=development and match the docker-compose service names.
#
# docker-compose.yml requires this file to exist (env_file:) even if empty --
# scripts/init-dev.sh creates .env.local from this template if it's missing.

# ENV=development
# DEBUG=false
# LOG_LEVEL=info

# DATABASE_URL=postgresql+asyncpg://app:app@pgbouncer:5432/app
# REDIS_URL=redis://redis:6379/0

# JWT signing key. Dev keeps the committed insecure default; any other ENV
# value refuses to boot without a unique 32+ char secret here.
# SECRET_KEY=

# CORS — JSON array of allowed browser origins. Must match the exact origin
# (scheme+host+port) the frontend is loaded from, e.g. http://127.0.0.1:3000
# is a DIFFERENT origin from http://localhost:3000 and will fail preflight.
# ALLOWED_ORIGINS=["http://localhost:3000"]

# Voice OTP (2Factor.in) — off by default, falls back to mock+email in dev.
# VOICE_OTP_ENABLED=false
# TWOFACTOR_API_KEY=

# Email (SMTP) — off by default.
# EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

# Razorpay — cashback/referral/commission payouts only, never loan principal.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
