# Copy to .env.local and fill in values. Never commit .env.local.

# Application
ENV=development
DEBUG=false
LOG_LEVEL=debug

# Database — points to pgbouncer, not postgres directly
# asyncpg driver; statement_cache_size=0 required for pgbouncer transaction mode (wired in db/session.py)
DATABASE_URL=postgresql+asyncpg://app:app@pgbouncer:5432/app

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://redis:6379/0

# Managed uploads. Development may leave scanning disabled when running without
# Docker; production must use the private-network ClamAV service.
MEDIA_MALWARE_SCAN_MODE=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Compose sets this to the secretless runtime on an internal-only network.
# Outside development the accepted value is exactly http://media-runtime:8080.
MEDIA_VIDEO_PROCESSOR_URL=

# JWT — generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MOBILE=3
OTP_RATE_LIMIT_PER_IP=10

# Support-assisted mobile-number recovery
MOBILE_CHANGE_RATE_LIMIT_PER_IP=10
MOBILE_CHANGE_RATE_LIMIT_PER_ACCOUNT=3
MOBILE_CHANGE_OTP_DAILY_LIMIT=3
MOBILE_CHANGE_REQUEST_EXPIRE_DAYS=7

# Agent lead attribution (stamped once on first attribution)
AGENT_LEAD_EXPIRY_DAYS=30

# CORS — JSON array string
ALLOWED_ORIGINS=["http://localhost:3000"]

# SMS — 2Factor.in primary, Fast2SMS failover
TWOFACTOR_API_KEY=
FAST2SMS_API_KEY=

# Payments — Razorpay (cashback / referral / commission payouts only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
