# Copy to .env.local (gitignored). Never commit real secrets.
ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth / JWT
JWT_SECRET=change-me-dev-only
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# SMS / OTP (2Factor.in primary, Fast2SMS failover)
TWOFACTOR_API_KEY=
FAST2SMS_API_KEY=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Object storage (DigitalOcean Spaces / S3-compatible)
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
