# Production env example for apps/api — copy to .env.prod and fill from your
# secrets manager. NEVER commit the real .env.prod (it is gitignored).
#
# This `prod` branch is where voice OTP (2Factor.in) is turned ON. The mainline
# keeps VOICE_OTP_ENABLED=false so dev/staging never place real calls; only prod
# deploys, tracking this branch, enable the live channel.

# --- Application ---
ENV=production
DEBUG=false
LOG_LEVEL=info

# --- Security ---
# Generate a unique 32+ char secret (e.g. `openssl rand -hex 32`). The app
# refuses to boot outside development with the committed dev default.
SECRET_KEY=__set_me__

# --- Database (point at pgbouncer, not postgres directly) ---
DATABASE_URL=postgresql+asyncpg://__user__:__password__@pgbouncer:5432/__db__
POSTGRES_DB=__db__
POSTGRES_USER=__user__
POSTGRES_PASSWORD=__password__

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS (JSON array) ---
ALLOWED_ORIGINS=["https://yourdomain.com"]

# --- OTP delivery: Voice (2Factor.in) ENABLED in prod ---
# Voice call reads out the code (no DLT/SMS). Empty key => mock+email fallback,
# so the key MUST be set for real delivery in prod.
VOICE_OTP_ENABLED=true
TWOFACTOR_API_KEY=__set_me__

# --- Email (OTP fallback + verification) ---
EMAIL_ENABLED=true
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=__set_me__
SMTP_PASSWORD=__set_me__
SMTP_FROM=Loans & Real Estate <no-reply@yourdomain.com>
SMTP_USE_TLS=true

# --- Payments: Razorpay (cashback / referral / commission payouts only) ---
RAZORPAY_KEY_ID=__set_me__
RAZORPAY_KEY_SECRET=__set_me__
