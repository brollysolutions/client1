            "title": "Otp Hint"
          }
        },
        "type": "object",
        "required": [
          "message",
          "delivery_channel"
        ],
        "title": "RegisterInitiateResponse"
      },
      "RegisterVerifyOtpRequest": {
        "properties": {
          "mobile": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "title": "Mobile"
          },
          "otp": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Otp"
          }
        },
        "type": "object",
        "required": [
          "mobile",
          "otp"
