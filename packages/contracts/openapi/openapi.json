        },
        "type": "object",
        "required": [
          "message",
          "delivery_channel"
        ],
        "title": "ForgotInitiateResponse"
      },
      "ForgotVerifyRequest": {
        "properties": {
          "mobile": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "title": "Mobile"
          },
          "otp": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Otp"
          }
        },
        "type": "object",
        "required": [
          "mobile",
          "otp"
        ],
        "title": "ForgotVerifyRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "mobile": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "title": "Mobile"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "mobile",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "first_name": {
            "type": "string",
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "mobile": {
            "type": "string",
            "title": "Mobile"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified"
          },
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/ClientProfileSummary"
            },
            "type": "array",
            "title": "Profiles"
          }
        },
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "mobile",
          "email",
          "email_verified",
          "profiles"
        ],
        "title": "MeResponse"
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageResponse"
      },
      "RegisterInitiateRequest": {
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Last Name"
          },
          "mobile": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "title": "Mobile"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "mobile",
          "email"
        ],
        "title": "RegisterInitiateRequest"
      },
      "RegisterInitiateResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "delivery_channel": {
            "type": "string",
            "enum": [
              "voice",
              "email",
              "none"
            ],
            "title": "Delivery Channel"
          },
          "otp_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
