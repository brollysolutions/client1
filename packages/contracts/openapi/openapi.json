          }
        },
        "type": "object",
        "required": [
          "registration_token"
        ],
        "title": "RegistrationTokenResponse"
      },
      "ResendOtpRequest": {
        "properties": {
          "mobile": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "title": "Mobile"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "register",
              "reset"
