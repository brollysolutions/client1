  "components": {
    "schemas": {
      "AuthTokensResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "phone_verified": {
            "type": "boolean",
            "title": "Phone Verified",
            "default": false
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "AuthTokensResponse"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password"
          },
          "confirm_password": {
            "type": "string",
            "title": "Confirm Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password",
          "confirm_password"
        ],
        "title": "ChangePasswordRequest"
      },
      "ClientProfileSummary": {
        "properties": {
          "business_line": {
            "type": "string",
            "enum": [
              "loans",
              "real_estate"
            ],
            "title": "Business Line"
          },
          "customer_code": {
            "type": "string",
            "title": "Customer Code"
          }
        },
        "type": "object",
        "required": [
          "business_line",
          "customer_code"
        ],
        "title": "ClientProfileSummary"
      },
      "EmailVerifyConfirmRequest": {
        "properties": {
          "otp": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Otp"
          }
        },
        "type": "object",
        "required": [
          "otp"
        ],
        "title": "EmailVerifyConfirmRequest"
      },
      "EmailVerifyInitiateResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "delivery_channel": {
            "type": "string",
            "enum": [
              "voice",
              "email",
              "none"
            ],
            "title": "Delivery Channel"
          },
          "otp_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Otp Hint"
          }
        },
        "type": "object",
        "required": [
          "message",
          "delivery_channel"
        ],
        "title": "EmailVerifyInitiateResponse"
      },
      "ForgotInitiateRequest": {
        "properties": {
          "mobile": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "title": "Mobile"
          }
        },
        "type": "object",
        "required": [
          "mobile"
        ],
        "title": "ForgotInitiateRequest"
      },
      "ForgotInitiateResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "delivery_channel": {
            "type": "string",
            "enum": [
              "voice",
              "email",
              "none"
            ],
            "title": "Delivery Channel"
          },
          "otp_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
