# Non-secret Docker Compose substitution values for the approved 4-GB profile.
# docker-compose.prod.example.yml carries the same defaults, so this file is an
# auditable reference. Copy it outside Git before changing a larger host's
# settings; every changed topology requires a fresh capacity rehearsal.
POSTGRES_MEMORY_LIMIT=352m
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_MAX_CONNECTIONS=40
REDIS_MEMORY_LIMIT=64m
REDIS_MAXMEMORY=32mb
CLAMAV_MEMORY_LIMIT=1408m
CLAMAV_NO_FRESHCLAMD=true
CLAMAV_CONCURRENT_DATABASE_RELOAD=no
CLAMAV_MAX_THREADS=1
CLAMAV_MAX_QUEUE=2
CLAMAV_MAX_CONNECTION_QUEUE_LENGTH=2
CLAMAV_STREAM_MAX_LENGTH=21M
CLAMAV_MAX_FILE_SIZE=21M
CLAMAV_MAX_SCAN_SIZE=64M
PGBOUNCER_MEMORY_LIMIT=32m
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=10
MEDIA_RUNTIME_MEMORY_LIMIT=768m
MEDIA_RUNTIME_CPUS=1.0
API_MEMORY_LIMIT=384m
API_WORKERS=1
API_LIMIT_CONCURRENCY=64
API_BACKLOG=64
ARGON2_CONCURRENCY=2
MEDIA_PROCESS_CONCURRENCY=1
SCHEDULER_MEMORY_LIMIT=224m
SCHEDULER_JOB_CONCURRENCY=1
MEDIA_PROCESS_BATCH_SIZE=1
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
WEB_MEMORY_LIMIT=224m
NGINX_MEMORY_LIMIT=32m
