{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(python --version)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(uv --version)",
      "Bash(ruff --version)",
      "Bash(pytest --version)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(./scripts/init-dev.sh *)",
      "Bash(./scripts/verify.sh *)",
      "Bash(./scripts/verify-api.sh *)",
      "Bash(./scripts/verify-web.sh *)",
      "Bash(./scripts/generate-openapi.sh *)",
      "Bash(./scripts/generate-client.sh *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(docker compose down -v*)",
      "Bash(psql *prod*)",
      "Bash(alembic downgrade *)",
      "Bash(kubectl delete *)",
      "Bash(terraform apply *)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/safe-bash.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-before-finish.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/node_modules/**/CLAUDE.md",
    "**/.venv/**/CLAUDE.md",
    "**/vendor/**/CLAUDE.md"
  ],
  "plansDirectory": "./docs/ai/plans"
}
